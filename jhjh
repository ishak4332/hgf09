            appState.isSpinning = true;
            document.getElementById('g3-wheel-result-box').classList.add('hidden');

            const extraSpins = 5 + Math.random() * 4;
            const totalRotation = extraSpins * 2 * Math.PI;
            const startAngle = appState.wheelAngle;
            const duration = 3400;
            const startTime = performance.now();
            let lastTickSlice = -1;

            function animateWheel(now) {
                const elapsed = now - startTime;
                const progress = Math.min(1, elapsed / duration);
                // Cubic ease out
                const eased = 1 - Math.pow(1 - progress, 3);
                appState.wheelAngle = startAngle + totalRotation * eased;
                drawWheelCanvas();

                const sliceAngle = (2 * Math.PI) / WHEEL_SLICES_2BAC2.length;
                const currentSlice = Math.floor((appState.wheelAngle % (2 * Math.PI)) / sliceAngle);
                if (currentSlice !== lastTickSlice) {
                    lastTickSlice = currentSlice;
                    sfxPop(420 + (1 - progress) * 350);
                }

                if (progress < 1) {
                    requestAnimationFrame(animateWheel);
                } else {
                    appState.isSpinning = false;
                    // Pointer is at the top (-Math.PI / 2 or 3*Math.PI/2)
                    const normAngle = ((3 * Math.PI / 2 - (appState.wheelAngle % (2 * Math.PI))) + 2 * Math.PI) % (2 * Math.PI);
                    const winIdx = Math.floor(normAngle / sliceAngle) % WHEEL_SLICES_2BAC2.length;
                    const winner = WHEEL_SLICES_2BAC2[winIdx];

                    sfxWin();
                    fireConfetti();

                    document.getElementById('g3-res-victim').textContent = appState.victimName;
                    document.getElementById('g3-res-text').textContent = winner.fullVerdict;
                    document.getElementById('g3-wheel-result-box').classList.remove('hidden');

                    publishEventToLiveWall({
                        victimName: appState.victimName,
                        badge: '🎡 عجلة الفضايح 2bac_2',
                        text: `حكمات عليه العجلة بـ: "${winner.fullVerdict}"`
                    });
                }
            }
            requestAnimationFrame(animateWheel);
        }

        /********************************************************************
         * 9. GAME 4: 🧠 سكانير دماغ 2bac_2
         ********************************************************************/
        function startGame4BrainScan(e) {
            if (e) e.preventDefault();
            if (appState.isScanning) return;
            appState.isScanning = true;

            const laser = document.getElementById('g4-laser');
            const ring = document.getElementById('g4-progress-ring');
            const pctEl = document.getElementById('g4-scan-pct');
            laser.classList.remove('hidden');

            let pct = 0;
            clearInterval(appState.scanTimer);
            appState.scanTimer = setInterval(() => {
                pct += 5;
                if (pct > 100) pct = 100;
                ring.style.strokeDashoffset = 326.7 - (pct / 100) * 326.7;
                pctEl.textContent = `${pct}%`;
                if (pct % 15 === 0) sfxPop(500 + pct * 4);

                if (pct >= 100) {
                    clearInterval(appState.scanTimer);
                    appState.isScanning = false;
                    showGame4BrainResult();
                }
            }, 65);
        }

        function showGame4BrainResult() {
            sfxWin();
            fireConfetti();

            const profile = BRAIN_RESULTS_2BAC2[Math.floor(Math.random() * BRAIN_RESULTS_2BAC2.length)];
            document.getElementById('g4-res-name').textContent = appState.victimName;
            document.getElementById('g4-res-verdict').textContent = profile.verdict;

            const box = document.getElementById('g4-bars-box');
            box.innerHTML = '';
            profile.bars.forEach(b => {
                box.innerHTML += `
                    <div>
                        <div class="flex justify-between text-xs font-bold mb-1">
                            <span class="text-slate-200">${b.name}</span>
                            <span class="font-mono text-cyan-300">${b.pct}%</span>
                        </div>
                        <div class="w-full h-2.5 bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full ${b.col} rounded-full" style="width:${b.pct}%"></div>
                        </div>
                    </div>
                `;
            });

            document.getElementById('g4-scan-view').classList.add('hidden');
            document.getElementById('g4-result-view').classList.remove('hidden');

            publishEventToLiveWall({
                victimName: appState.victimName,
                badge: '🧠 سكانير دماغ 2bac_2',
                text: `نتيجة السكانير: ${profile.bars[0].name} (${profile.bars[0].pct}%) — ${profile.verdict}`
            });
        }

        function resetGame4() {
            clearInterval(appState.scanTimer);
            appState.isScanning = false;
            document.getElementById('g4-laser').classList.add('hidden');
            document.getElementById('g4-progress-ring').style.strokeDashoffset = 326.7;
            document.getElementById('g4-scan-pct').textContent = '0%';
            document.getElementById('g4-result-view').classList.add('hidden');
            document.getElementById('g4-scan-view').classList.remove('hidden');
        }

        /********************************************************************
         * 9.5 GAME 5: 🎓 نقط مسار المسربة (FAKE MASSAR GRADES)
         ********************************************************************/
