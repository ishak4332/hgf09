        /********************************************************************
         * 10. LIVE ONLINE WALL & 1-TAP CLASS POLLS
         ********************************************************************/
        function escHtml(str) {
            return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        function renderLiveWall() {
            const listEl = document.getElementById('live-wall-list');
            const sorted = [...appState.liveFeed].sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));

            document.getElementById('header-live-count').textContent = sorted.length;
            document.getElementById('live-feed-badge').textContent = `${sorted.length} فـ اللايف`;

            listEl.innerHTML = '';
            sorted.forEach(item => {
                const r = item.reactions || { laugh: 0, fire: 0, skull: 0 };
                const card = document.createElement('div');
                card.className = 'p-3.5 rounded-2xl bg-slate-950 border border-slate-800 space-y-2';
                card.innerHTML = `
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex items-center gap-2">
                            <span class="font-black text-xs sm:text-sm text-white">${escHtml(item.victimName)}</span>
                            <span class="text-[10px] font-black px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">${escHtml(item.badge)}</span>
                        </div>
                        <span class="text-[10px] text-emerald-400 font-bold">مباشر 🔴</span>
                    </div>
                    <p class="text-xs sm:text-sm font-bold text-slate-200 leading-relaxed">${escHtml(item.text)}</p>
                    <div class="flex items-center gap-2 pt-1">
                        <button onclick="reactLiveItem('${item.id}', 'laugh')" class="px-2.5 py-1 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-xs font-bold flex items-center gap-1 active:scale-90 transition">
                            <span>😂</span><span class="font-mono text-slate-300">${r.laugh || 0}</span>
                        </button>
                        <button onclick="reactLiveItem('${item.id}', 'fire')" class="px-2.5 py-1 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-xs font-bold flex items-center gap-1 active:scale-90 transition">
                            <span>🔥</span><span class="font-mono text-slate-300">${r.fire || 0}</span>
                        </button>
                        <button onclick="reactLiveItem('${item.id}', 'skull')" class="px-2.5 py-1 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-xs font-bold flex items-center gap-1 active:scale-90 transition">
                            <span>💀</span><span class="font-mono text-slate-300">${r.skull || 0}</span>
                        </button>
                    </div>
                `;
                listEl.appendChild(card);
            });
        }

        function renderLivePolls() {
            const box = document.getElementById('live-polls-list');
            box.innerHTML = '';
            appState.polls.forEach(poll => {
                const total = (poll.options || []).reduce((s, o) => s + (o.votes || 0), 0) || 1;
                let optsHtml = '';
                (poll.options || []).forEach((o, idx) => {
                    const pct = Math.round(((o.votes || 0) / total) * 100);
                    optsHtml += `
                        <button onclick="voteInPoll('${poll.id}', ${idx})" class="w-full text-right p-2 rounded-xl bg-slate-900 hover:bg-indigo-950/40 border border-slate-800 transition space-y-1">
                            <div class="flex justify-between text-xs font-bold">
                                <span class="text-white">${escHtml(o.name)}</span>
                                <span class="font-mono text-amber-400">${o.votes || 0} صوت (${pct}%)</span>
                            </div>
                            <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
                                <div class="h-full bg-gradient-to-l from-amber-400 to-pink-500 rounded-full" style="width:${pct}%"></div>
                            </div>
                        </button>
                    `;
                });

                const card = document.createElement('div');
                card.className = 'p-3.5 rounded-2xl bg-slate-950 border border-slate-800 space-y-2.5';
                card.innerHTML = `
                    <h4 class="text-xs sm:text-sm font-black text-white">${escHtml(poll.question)}</h4>
                    <div class="space-y-1.5">${optsHtml}</div>
                    <div class="flex gap-1.5 pt-1">
                        <input type="text" id="poll-add-${poll.id}" placeholder="+ زيد سمية صاحبك فـ 2bac_2..." maxlength="24"
                            class="flex-1 px-2.5 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-[11px] font-bold focus:outline-none">
                        <button onclick="addFriendToPoll('${poll.id}')" class="px-3 py-1.5 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[11px] font-black">
                            زيدو +
                        </button>
                    </div>
                `;
                box.appendChild(card);
            });
        }

        function publishEventToLiveWall(item) {
            const newDoc = {
                id: 'local_' + Date.now(),
                victimName: item.victimName || appState.victimName,
                badge: item.badge || 'فخ 2bac_2',
                text: item.text || '',
                timestamp: Date.now(),
                reactions: { laugh: 1, fire: 1, skull: 0 }
            };
            if (typeof window.cloudAddVictim === 'function') {
                window.cloudAddVictim(newDoc);
            } else {
                appState.liveFeed.unshift(newDoc);
                renderLiveWall();
            }
        }

        function postQuickLiveRoast() {
            const nameEl = document.getElementById('live-author-input');
            const msgEl = document.getElementById('live-msg-input');
            const author = nameEl.value.trim() || 'ولد 2bac_2 😎';
            const text = msgEl.value.trim();
            if (!text) {
                notifyToast('✍️ كتب شي قصف أولا نكتة بعدا!');
                return;
            }
            sfxPop();
            msgEl.value = '';
            publishEventToLiveWall({
                victimName: author,
                badge: '💬 قصف مباشر',
                text: text
            });
            notifyToast('🔥 تنشر الميساج ديالك فـ اللايف!');
        }

        function reactLiveItem(id, key) {
            sfxPop();
            const found = appState.liveFeed.find(x => x.id === id);
            if (found) {
                if (!found.reactions) found.reactions = { laugh: 0, fire: 0, skull: 0 };
                found.reactions[key] = (found.reactions[key] || 0) + 1;
                renderLiveWall();
            }
            if (typeof window.cloudReactVictim === 'function') {
                window.cloudReactVictim(id, key);
            }
        }

        function voteInPoll(pollId, idx) {
            sfxPop();
            const p = appState.polls.find(x => x.id === pollId);
            if (!p || !p.options[idx]) return;
            p.options[idx].votes = (p.options[idx].votes || 0) + 1;
            renderLivePolls();
            if (typeof window.cloudSavePoll === 'function') window.cloudSavePoll(p);
        }

        function addFriendToPoll(pollId) {
            const inp = document.getElementById(`poll-add-${pollId}`);
            if (!inp || !inp.value.trim()) return;
            const friendName = inp.value.trim();
            inp.value = '';
            sfxPop();
            const p = appState.polls.find(x => x.id === pollId);
            if (!p) return;
            p.options.push({ name: friendName, votes: 1 });
            renderLivePolls();
            if (typeof window.cloudSavePoll === 'function') window.cloudSavePoll(p);
            notifyToast(`✅ تضاف "${friendName}" للتصويت!`);
        }

        /********************************************************************
         * 11. INITIALIZE ON PAGE LOAD & URL AUTO-TRAP DETECTION
         ********************************************************************/
        window.onload = function () {
            renderQuestionChips();
            drawWheelCanvas();
            renderLiveWall();
            renderLivePolls();
            selectPrankGame(DEFAULT_GROUP_START_GAME || 1);

            // Auto-open Class Group Student Portal if exported with FORCE_GROUP_LOCK = true or #group hash
            if (FORCE_GROUP_LOCK || window.location.hash === '#group') {
                activateClassGroupPortalMode();
            }
        };
    </script>

    <!-- ================================================================= -->
    <!-- 12. FIREBASE REAL-TIME SYNC MODULE (2BAC_2 LIVE ONLINE)           -->
    <!-- ================================================================= -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, getDoc, setDoc, addDoc, updateDoc, onSnapshot, collection } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-2bac2-app';
        let db = null;
        let auth = null;
        let currentUser = null;
        let seeded = false;

        async function startCloudSync() {
            try {
                if (typeof __firebase_config === 'undefined' || !__firebase_config) return;
                const app = initializeApp(JSON.parse(__firebase_config));
                db = getFirestore(app);
                auth = getAuth(app);

                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                onAuthStateChanged(auth, (user) => {
                    currentUser = user;
                    if (!currentUser) return;

                    // Live Feed Listener
                    const feedCol = collection(db, 'artifacts', appId, 'public', 'data', 'live_wall_2bac2');
                    onSnapshot(feedCol, (snap) => {
                        if (!currentUser) return;
                        if (snap.empty && !seeded) {
                            seeded = true;
                            SEED_LIVE_FEED.forEach(s => {
                                setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'live_wall_2bac2', s.id), s).catch(() => {});
                            });
                            return;
                        }
                        const items = [];
                        snap.forEach(d => items.push({ id: d.id, ...d.data() }));
                        if (items.length > 0) {
                            appState.liveFeed = items;
                            renderLiveWall();
                        }
                    }, () => {});

                    // Live Polls Listener
                    const pollsCol = collection(db, 'artifacts', appId, 'public', 'data', 'polls_2bac2');
                    onSnapshot(pollsCol, (snap) => {
                        if (!currentUser) return;
                        if (snap.empty) {
                            SEED_POLLS.forEach(p => {
                                setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'polls_2bac2', p.id), p).catch(() => {});
                            });
                            return;
                        }
                        const pList = [];
                        snap.forEach(d => pList.push({ id: d.id, ...d.data() }));
                        if (pList.length > 0) {
                            appState.polls = pList;
                            renderLivePolls();
                        }
                    }, () => {});
                });
            } catch (e) {}
        }

        window.cloudAddVictim = async function (record) {
            if (!currentUser || !db) {
                appState.liveFeed.unshift(record);
                renderLiveWall();
                return;
            }
            try {
                await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'live_wall_2bac2'), {
                    victimName: record.victimName,
                    badge: record.badge,
                    text: record.text,
                    timestamp: Date.now(),
                    reactions: record.reactions || { laugh: 1, fire: 1, skull: 0 }
                });
            } catch (e) {
                appState.liveFeed.unshift(record);
                renderLiveWall();
            }
        };

        window.cloudReactVictim = async function (docId, key) {
            if (!currentUser || !db || !docId || docId.startsWith('local_')) return;
            try {
                const ref = doc(db, 'artifacts', appId, 'public', 'data', 'live_wall_2bac2', docId);
                const snap = await getDoc(ref);
                if (snap.exists()) {
                    const reactions = snap.data().reactions || { laugh: 0, fire: 0, skull: 0 };
                    reactions[key] = (reactions[key] || 0) + 1;
                    await updateDoc(ref, { reactions });
                }
            } catch (e) {}
        };

        window.cloudSavePoll = async function (pollObj) {
            if (!currentUser || !db || !pollObj || !pollObj.id) return;
            try {
                await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'polls_2bac2', pollObj.id), pollObj);
            } catch (e) {}
        };

        window.cloudSaveTrapByCode = async function (code, payload) {
            if (!currentUser || !db || !code) return;
            try {
                await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'traps_2bac2', String(code)), payload);
            } catch (e) {}
        };

        window.cloudFetchTrapByCode = async function (code, callback) {
            if (!currentUser || !db || !code) {
                if (callback) callback(null);
                return;
            }
            try {
                const snap = await getDoc(doc(db, 'artifacts', appId, 'public', 'data', 'traps_2bac2', String(code)));
                if (snap.exists()) {
                    const data = snap.data();
                    appState.trapsByCode[String(code)] = data;
                    if (callback) callback(data);
                } else {
                    if (callback) callback(null);
                }
            } catch (e) {
                if (callback) callback(null);
            }
        };

        startCloudSync();
    </script>
