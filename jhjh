        /********************************************************************
         * 8. GAME 3: 🎡 عجلة الحظ والفضايح ديال 2bac_2 (HTML5 CANVAS WHEEL)
         ********************************************************************/
        function drawWheelCanvas() {
            const canvas = document.getElementById('wheel-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const cx = canvas.width / 2;
            const cy = canvas.height / 2;
            const radius = cx - 6;
            const sliceAngle = (2 * Math.PI) / WHEEL_SLICES_2BAC2.length;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            WHEEL_SLICES_2BAC2.forEach((slice, i) => {
                const startAngle = appState.wheelAngle + i * sliceAngle;
                const endAngle = startAngle + sliceAngle;

                ctx.beginPath();
                ctx.moveTo(cx, cy);
                ctx.arc(cx, cy, radius, startAngle, endAngle);
                ctx.closePath();
                ctx.fillStyle = slice.color;
                ctx.fill();
                ctx.lineWidth = 2;
                ctx.strokeStyle = '#0f172a';
                ctx.stroke();

                // Draw Slice Text
                ctx.save();
                ctx.translate(cx, cy);
                ctx.rotate(startAngle + sliceAngle / 2);
                ctx.textAlign = 'right';
                ctx.fillStyle = '#ffffff';
                ctx.font = '900 13px Cairo, sans-serif';
                ctx.shadowColor = 'rgba(0,0,0,0.6)';
                ctx.shadowBlur = 4;
                ctx.fillText(slice.label, radius - 16, 5);
                ctx.restore();
            });
        }

